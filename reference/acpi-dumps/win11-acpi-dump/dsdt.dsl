                    If (LEqual (Arg1, Zero))
                    {
                        Notify (BAT0, 0x81) // Information Change
                    }

                    If (LEqual (Arg1, One))
                    {
                        Notify (BAT1, 0x81) // Information Change
                    }
                }

                If (LEqual (Arg0, 0x02))
                {
                    If (LEqual (Arg1, Zero))
                    {
                        Notify (BAT0, 0x80) // Status Change
                        Notify (BAT0, 0x81) // Information Change
                    }

                    If (LEqual (Arg1, One))
                    {
                        Notify (BAT1, 0x80) // Status Change
                        Notify (BAT1, 0x81) // Information Change
                    }
                }

                If (LEqual (Arg0, 0x03))
                {
                    If (LEqual (Arg1, Zero))
                    {
                        Notify (BAT0, 0x80) // Status Change
                    }

                    If (LEqual (Arg1, One))
                    {
                        Notify (BAT1, 0x80) // Status Change
                    }
                }

                If (LEqual (Arg0, 0x04))
                {
                    Notify (BAT0, 0x80) // Status Change
                }
            }

            Method (CBAT, 2, NotSerialized)
            {
                Notify (BAT0, 0x81) // Information Change
                Notify (BAT1, 0x81) // Information Change
                Store (ECG5 (), Local0)
                And (Local0, 0x2B, APRE) /* \APRE */
            }
