                    {
                        Return (Package (0x01)
                        {
                            MRST, 
                        })
                    }
                }

                Return (Package (0x01)
                {
                    DRST, 
                })
            }

            Method (IFUN, 4, Serialized)
            {
                If (LEqual (Arg2, Zero))
                {
