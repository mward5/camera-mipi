                        })
                    }
                    Else
                    {
                        Return (Buffer (One)
                        {
                             0x00                                             // .
                        })
                    }
                }

                If (LEqual (Arg2, One))
                {
                    ShiftLeft (CVPR, Zero, Local0)
                    Return (Local0)
                }

                If (LEqual (Arg2, 0x02))
                {
                    CreateWordField (Arg3, Zero, CMDT)
                    CreateWordField (Arg3, 0x02, CMDP)
                    If (LEqual (CMDT, One))
                    {
