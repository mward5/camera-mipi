                PBUS,   8, 
                SBUS,   8
            }

            Store (GPCB (), Local0)
            Add (Local0, ShiftRight (And (Arg1, 0x001F0000), One), Local0)
            Add (Local0, ShiftLeft (And (Arg1, 0x07), 0x0C), Local0)
            Add (Local0, ShiftLeft (SBUS, 0x14), Local0)
            Return (Local0)
        }

