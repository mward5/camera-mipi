    Scope (_SB.PC00.SPI1)
    {
        Name (SPIP, Zero)
        Name (SPIX, 0x07)
        Method (_INI, 0, NotSerialized)  // _INI: Initialize
        {
            Store (SDS7, SPIP) /* \_SB_.PC00.SPI1.SPIP */
            Store (0x07, SPIX) /* \_SB_.PC00.SPI1.SPIX */
        }

        Device (FPNT)
        {
            Method (_HID, 0, NotSerialized)  // _HID: Hardware ID
            {
                If (LEqual (FPTT, One))
                {
                    Return ("FPC1011")
                }

                If (LEqual (FPTT, 0x02))
                {
                    Return ("FPC1020")
                }

                If (LEqual (FPTT, 0x03))
                {
                    Return ("VFSI6101")
                }

                If (LEqual (FPTT, 0x04))
