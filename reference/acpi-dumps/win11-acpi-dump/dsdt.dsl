                {
                    PSD0 (SLOT)
                    If (CondRefOf (WOFF))
                    {
                        If (LNotEqual (WOFF, Zero))
                        {
                            Divide (Subtract (Timer, WOFF), 0x2710, , Local0)
                            If (LLess (Local0, TFDI))
                            {
                                Sleep (Subtract (TFDI, Local0))
                            }

                            If (CondRefOf (PWRG))
                            {
                                \PIN.ON (PWRG)
                            }

                            Sleep (TN2B)
                            If (CondRefOf (BRST))
                            {
                                \PIN.OFF (BRST)
                            }

                            Sleep (TB2R)
                        }
                    }

                    If (CondRefOf (SCLK))
                    {
                        SPCO (SCLK, One)
                    }

