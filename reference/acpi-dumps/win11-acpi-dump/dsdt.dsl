                        Store (0x20, ACOS) /* \_SB_.ACOS */
                    }

                    If (_OSI (WIN7))
                    {
                        Store (0x80, ACOS) /* \_SB_.ACOS */
                    }

                    If (_OSI (WIN8))
                    {
                        Store (0x80, ACOS) /* \_SB_.ACOS */
                        Store (One, ACSE) /* \_SB_.ACSE */
                    }

                    If (_OSI (WN81))
                    {
                        Store (0x80, ACOS) /* \_SB_.ACOS */
                        Store (0x02, ACSE) /* \_SB_.ACSE */
                    }
