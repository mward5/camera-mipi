                        }
                        Else
                        {
                            Return (Zero)
                        }
                    }

                    If (LEqual (CMDT, 0x02))
                    {
                        If (CondRefOf (\_SB.PC00.CNVW.RSTT))
                        {
                            Store (CMDP, ^^^CNVW.RSTT) /* \_SB_.PC00.CNVW.RSTT */
                        }

                        Return (Zero)
                    }

                    If (LEqual (CMDT, 0x03))
                    {
                        If (CondRefOf (\_SB.PC00.CNVW.PRRS))
                        {
                            Return (^^^CNVW.PRRS) /* \_SB_.PC00.CNVW.PRRS */
                        }
                        Else
                        {
                            Return (Zero)
                        }
                    }

                    Return (Zero)
                }

                If (LEqual (Arg2, 0x03))
                {
                    If (LEqual (CRFI, One))
                    {
                        Return (Zero)
                    }
                    Else
                    {
                        Return (One)
                    }
                }

                Return (Zero)
            }

            Method (IDSM, 1, Serialized)
            {
                If (LEqual (Arg0, ToUUID ("7266172c-220b-4b29-814f-75e4dd26b5fd") /* Unknown UUID */))
                {
                    Return (One)
                }

                Return (Zero)
            }

            Method (EFUN, 4, Serialized)
            {
                If (LEqual (Arg2, Zero))
                {
                    If (LEqual (Arg1, Zero))
                    {
                        Return (Buffer (One)
                        {
                             0x7F                                             // .
                        })
                    }
                    Else
                    {
                        Return (Buffer (One)
                        {
                             0x00                                             // .
                        })
                    }
                }

                If (LEqual (Arg2, One))
                {
                    Store (ACSD, Local0)
                    Return (Local0)
                }

                If (LEqual (Arg2, 0x02))
                {
                    Store (I5BS, Local0)
                    Return (Local0)
                }

                If (LEqual (Arg2, 0x03))
                {
                    Store (UHBS, Local0)
                    Return (Local0)
                }

                If (LEqual (Arg2, 0x06))
                {
                    Store (AXMU, Local0)
                    ShiftLeft (Local0, One, Local0)
                    Or (Local0, AXSU, Local0)
                    Store (AXMR, Local1)
                    ShiftLeft (Local1, One, Local1)
                    Or (Local1, AXSR, Local1)
                    ShiftLeft (Local1, 0x02, Local1)
                    Or (Local0, Local1, Local0)
                    Return (Local0)
                }

                If (LEqual (Arg2, 0x04))
                {
                    Return (WFRC) /* \WFRC */
                }

                If (LEqual (Arg2, 0x05))
                {
                    Return (WFUC) /* \WFUC */
                }

                If (LEqual (Arg2, 0x07))
                {
                    Return (UNI4) /* \UNI4 */
                }

                If (LEqual (Arg2, 0x08))
