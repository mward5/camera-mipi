                    While (LAnd (LEqual (APC3, Zero), LLess (Local0, 0x2710)))
                    {
                        Increment (Local0)
                        Sleep (One)
                    }
                }
                Case (0x0C)
                {
                    Store (One, RPD0) /* \RPD0 */
                    While (LAnd (LEqual (APD0, Zero), LLess (Local0, 0x2710)))
                    {
                        Increment (Local0)
                        Sleep (One)
                    }
                }
                Case (0x0D)
                {
                    Store (One, RPD1) /* \RPD1 */
                    While (LAnd (LEqual (APD1, Zero), LLess (Local0, 0x2710)))
                    {
