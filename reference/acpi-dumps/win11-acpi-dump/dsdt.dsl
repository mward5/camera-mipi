                Store (SD23, Index (DerefOf (Index (WGDY, One)), 0x0C))
                Store (SD24, Index (DerefOf (Index (WGDY, One)), 0x0D))
                Store (SD25, Index (DerefOf (Index (WGDY, One)), 0x0E))
                Store (SD26, Index (DerefOf (Index (WGDY, One)), 0x0F))
                Store (SD27, Index (DerefOf (Index (WGDY, One)), 0x10))
                Store (SD28, Index (DerefOf (Index (WGDY, One)), 0x11))
                Store (SD29, Index (DerefOf (Index (WGDY, One)), 0x12))
                Store (SD31, Index (DerefOf (Index (WGDY, One)), 0x13))
                Store (SD32, Index (DerefOf (Index (WGDY, One)), 0x14))
                Store (SD33, Index (DerefOf (Index (WGDY, One)), 0x15))
