                {
                    Store (ACSD, Local0)
                    Return (Local0)
                }

                If (LEqual (Arg2, 0x02))
                {
                    Store (I5BS, Local0)
                    Return (Local0)
                }

                If (LEqual (Arg2, 0x03))
                {
                    Store (UHBS, Local0)
                    Return (Local0)
                }

                If (LEqual (Arg2, 0x06))
                {
                    Store (AXMU, Local0)
