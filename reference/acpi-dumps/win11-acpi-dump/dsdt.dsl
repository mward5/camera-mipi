                    Store ("ATML3432", _HID) /* \_SB_.PC00.I2C4.TPL0._HID */
                    Store (Zero, HID2) /* \_SB_.PC00.I2C4.TPL0.HID2 */
                    Store (0x4C, BADR) /* \_SB_.PC00.I2C4.TPL0.BADR */
                    Store (0x00061A80, SPED) /* \_SB_.PC00.I2C4.TPL0.SPED */
                    Return (Zero)
                }

                If (LEqual (TPLT, 0x02))
                {
                    Store ("ATML2952", _HID) /* \_SB_.PC00.I2C4.TPL0._HID */
                    Store (Zero, HID2) /* \_SB_.PC00.I2C4.TPL0.HID2 */
                    Store (0x4A, BADR) /* \_SB_.PC00.I2C4.TPL0.BADR */
                    Store (0x00061A80, SPED) /* \_SB_.PC00.I2C4.TPL0.SPED */
                    Return (Zero)
                }

                If (LEqual (TPLT, 0x03))
                {
                    Store ("ELAN9048", _HID) /* \_SB_.PC00.I2C4.TPL0._HID */
                    Store (One, HID2) /* \_SB_.PC00.I2C4.TPL0.HID2 */
                    Store (0x10, BADR) /* \_SB_.PC00.I2C4.TPL0.BADR */
                    Store (0x00061A80, SPED) /* \_SB_.PC00.I2C4.TPL0.SPED */
                    Return (Zero)
                }

                If (LEqual (TPLT, 0x04))
                {
                    Store ("NTRG0001", _HID) /* \_SB_.PC00.I2C4.TPL0._HID */
                    Store (One, HID2) /* \_SB_.PC00.I2C4.TPL0.HID2 */
                    Store (0x07, BADR) /* \_SB_.PC00.I2C4.TPL0.BADR */
                    Store (0x00061A80, SPED) /* \_SB_.PC00.I2C4.TPL0.SPED */
                    Return (Zero)
                }

                If (LEqual (TPLT, 0x05))
                {
                    Store ("NTRG0002", _HID) /* \_SB_.PC00.I2C4.TPL0._HID */
                    Store (One, HID2) /* \_SB_.PC00.I2C4.TPL0.HID2 */
                    Store (0x64, BADR) /* \_SB_.PC00.I2C4.TPL0.BADR */
                    Store (0x00061A80, SPED) /* \_SB_.PC00.I2C4.TPL0.SPED */
                    Return (Zero)
                }

                If (LEqual (TPLT, 0x06))
                {
                    Store ("WCOM508E", _HID) /* \_SB_.PC00.I2C4.TPL0._HID */
                    Store (One, HID2) /* \_SB_.PC00.I2C4.TPL0.HID2 */
                    Store (0x0A, BADR) /* \_SB_.PC00.I2C4.TPL0.BADR */
                    If (LEqual (TPLS, Zero))
                    {
                        Store (0x00061A80, SPED) /* \_SB_.PC00.I2C4.TPL0.SPED */
                    }

                    If (LEqual (TPLS, One))
                    {
                        Store (0x00061A80, SPED) /* \_SB_.PC00.I2C4.TPL0.SPED */
                    }

                    If (LEqual (TPLS, 0x02))
                    {
                        Store (0x000F4240, SPED) /* \_SB_.PC00.I2C4.TPL0.SPED */
                    }

                    Return (Zero)
                }

                If (LEqual (TPLT, 0x07))
                {
                    Store ("WACF3233", _HID) /* \_SB_.PC00.I2C4.TPL0._HID */
                    Store (TPLH, HID2) /* \_SB_.PC00.I2C4.TPL0.HID2 */
                    Store (TPLB, BADR) /* \_SB_.PC00.I2C4.TPL0.BADR */
                    If (LEqual (TPLS, Zero))
                    {
                        Store (0x000186A0, SPED) /* \_SB_.PC00.I2C4.TPL0.SPED */
                    }

                    If (LEqual (TPLS, One))
                    {
                        Store (0x00061A80, SPED) /* \_SB_.PC00.I2C4.TPL0.SPED */
                    }

                    If (LEqual (TPLS, 0x02))
                    {
                        Store (0x000F4240, SPED) /* \_SB_.PC00.I2C4.TPL0.SPED */
                    }

                    Return (Zero)
