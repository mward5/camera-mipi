                }

                Sleep (TR2B)
                SGOV (WBRS, PBRS)
                If (LEqual (Arg0, Zero))
                {
                    Sleep (TBTG)
                }
                ElseIf (LEqual (Arg0, One))
                {
                    SPCO (WCLK, Zero)
                    Sleep (TB2F)
                    SGOV (WFCP, And (Not (PFCP), One))
                    Sleep (TFDI)
