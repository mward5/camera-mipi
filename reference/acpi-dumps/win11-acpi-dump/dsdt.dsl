    Scope (_SB)
    {
        Device (VDGS)
        {
            Name (_HID, "DELL0029")  // _HID: Hardware ID
            Name (_CID, "PNP0C90")  // _CID: Compatible ID
            Name (_STR, Unicode ("Dell CORE Gateway Service v1.0"))  // _STR: Description String
            Name (TOKE, Buffer (0x10){})
            CreateDWordField (TOKE, Zero, TOK0)
            Method (_STA, 0, NotSerialized)  // _STA: Status
            {
                Store (GENS (0x22, TOK0, 0x04), TOK0) /* \_SB_.VDGS.TOK0 */
                If (LEqual (TOK0, One))
                {
                    Return (0x0F)
                }
                Else
                {
                    Return (Zero)
                }
            }
        }

        Device (DCSD)
        {
            Name (_HID, "DELL0033")  // _HID: Hardware ID
            Name (_CID, "DELL_DCSD_DEVICE")  // _CID: Compatible ID
            Name (_STR, Unicode ("Dell Connected Service Delivery Device"))  // _STR: Description String
            Name (TEMP, Buffer (0x04){})
            CreateDWordField (TEMP, Zero, BUF0)
            Method (_STA, 0, NotSerialized)  // _STA: Status
            {
                Store (GENS (0x25, BUF0, 0x04), BUF0) /* \_SB_.DCSD.BUF0 */
                If (LEqual (BUF0, One))
                {
                    Return (0x0F)
                }
                Else
                {
                    Return (Zero)
                }
            }
        }
    }

    Scope (_SB.AMW0)
    {
        Name (WMEV, Zero)
        Name (WMBU, Buffer (0x80){})
        Name (WM, Zero)
        Method (SWEV, 1, NotSerialized)
        {
            Or (WMEV, Arg0, WMEV) /* \_SB_.AMW0.WMEV */
        }

        Method (CWEV, 1, NotSerialized)
        {
            And (WMEV, Not (Arg0), WMEV) /* \_SB_.AMW0.WMEV */
        }

        Method (WVSP, 0, NotSerialized)
        {
            Store (Zero, WM) /* \_SB_.AMW0.WM__ */
            BCLR (WMBU)
        }

        Method (WVCU, 0, NotSerialized)
        {
            Store (Zero, WM) /* \_SB_.AMW0.WM__ */
        }

        Method (WVPT, 1, NotSerialized)
        {
            Store (WM, Local0)
            Add (Local0, 0x02, Local0)
            If (LLessEqual (Local0, SizeOf (WMBU)))
            {
                CreateWordField (WMBU, WM, WMWD)
                Store (Arg0, WMWD) /* \_SB_.AMW0.WVPT.WMWD */
                Store (Local0, WM) /* \_SB_.AMW0.WM__ */
            }
        }

        Method (_WED, 1, Serialized)  // _Wxx: Wake Event, xx=0x00-0xFF
        {
            WVSP ()
            If (LNotEqual (Arg0, 0xD0))
            {
                WVCU ()
                Return (WMBU) /* \_SB_.AMW0.WMBU */
            }

            If (LEqual (ECD0, Zero))
            {
                WVCU ()
                Return (WMBU) /* \_SB_.AMW0.WMBU */
            }

            If (And (WMEV, 0x0200))
            {
                CWEV (0x0200)
                WVPT (0x02)
                WVPT (Zero)
                WVPT (0xE045)
            }
            ElseIf (And (WMEV, 0x0100))
            {
                CWEV (0x0100)
                If (ECG4 ())
                {
                    WVPT (0x02)
                    WVPT (Zero)
                    WVPT (0xE043)
                }
                Else
                {
                    WVPT (0x02)
                    WVPT (Zero)
                    WVPT (0xE044)
                }
            }
            ElseIf (And (WMEV, 0x0800))
            {
                Store (EC0A (WMBU), WMBU) /* \_SB_.AMW0.WMBU */
                CreateWordField (WMBU, Zero, WMI0)
                CreateWordField (WMBU, 0x02, WMI1)
                CreateWordField (WMBU, 0x04, WMI2)
                CreateWordField (WMBU, 0x06, WMI3)
                CreateWordField (WMBU, 0x08, WMI4)
                CreateWordField (WMBU, 0x0A, WMI5)
                CreateWordField (WMBU, 0x0C, WMI6)
                If (LEqual (OSID (), 0x80))
                {
                    If (And (LEqual (WMI1, 0x10), LEqual (WMI2, 0xE035)))
                    {
                        Store (0x02, WMI0) /* \_SB_.AMW0._WED.WMI0 */
                        Store (0x12, WMI1) /* \_SB_.AMW0._WED.WMI1 */
                        Store (0xE035, WMI2) /* \_SB_.AMW0._WED.WMI2 */
                    }
                }

                EV5 (Zero, Zero)
                CWEV (0x0800)
            }
            ElseIf (And (WMEV, 0x40000000))
            {
                Store ("WMI event DKL Update", Debug)
                CreateWordField (WMBU, Zero, SIZE)
                CreateWordField (WMBU, 0x02, TYPE)
                CreateWordField (WMBU, 0x04, STYP)
                CreateByteField (WMBU, 0x06, STAT)
                Store (0x07, SIZE) /* \_SB_.AMW0._WED.SIZE */
                Store (0x12, TYPE) /* \_SB_.AMW0._WED.TYPE */
                Store (0x10, STYP) /* \_SB_.AMW0._WED.STYP */
                Store (ECRB (0x77), STAT) /* \_SB_.AMW0._WED.STAT */
                CWEV (0x40000000)
            }

            WVCU ()
            Return (WMBU) /* \_SB_.AMW0.WMBU */
        }
    }

    Scope (\)
    {
        Method (WMNF, 2, NotSerialized)
        {
            \_SB.AMW0.SWEV (Arg0)
            Notify (\_SB.AMW0, 0xD0) // Hardware-Specific
        }
    }

    Scope (_SB)
    {
        Device (AMWV)
        {
            Name (_HID, "PNP0C14" /* Windows Management Instrumentation Device */)  // _HID: Hardware ID
            Name (_UID, "ADDV")  // _UID: Unique ID
            Name (_WDG, Buffer (0x28)
            {
                /* 0000 */  0x14, 0xEA, 0x42, 0x8A, 0x2A, 0x4F, 0x45, 0xFD,  // ..B.*OE.
                /* 0008 */  0x64, 0x22, 0x00, 0x87, 0xF7, 0xA7, 0xE6, 0x08,  // d"......
                /* 0010 */  0x44, 0x56, 0x01, 0x02, 0x21, 0x12, 0x90, 0x05,  // DV..!...
                /* 0018 */  0x66, 0xD5, 0xD1, 0x11, 0xB2, 0xF0, 0x00, 0xA0,  // f.......
                /* 0020 */  0xC9, 0x06, 0x29, 0x10, 0x4D, 0x4F, 0x01, 0x00   // ..).MO..
            })
            Method (WMDV, 3, Serialized)
            {
                CreateByteField (Arg2, Zero, BFB0)
                CreateByteField (Arg2, One, BFB1)
                CreateByteField (Arg2, 0x02, BFB2)
                If (LEqual (Arg1, One))
                {
                    Acquire (ECM1, 0xFFFF)
                    ECWB (0x03, BFB0)
                    Store (ECRW (0x20), Local0)
                    Release (ECM1)
                    Return (Local0)
                }

                If (LEqual (Arg1, 0x02))
                {
                    Acquire (ECM1, 0xFFFF)
                    ECWB (0x03, BFB0)
                    Store (ECRW (0x1E), Local0)
                    Release (ECM1)
                    Return (Local0)
                }

                If (LEqual (Arg1, 0x03))
                {
                    Acquire (ECM1, 0xFFFF)
                    ECWB (0x03, BFB0)
                    Store (ECRB (0x28), Local3)
                    Store (ECU0 (BS02, Local3), Local3)
                    Release (ECM1)
                    Return (ToString (Local3, Ones))
                }

                If (LEqual (Arg1, 0x04))
                {
                    Acquire (ECM1, 0xFFFF)
                    ECWB (0x03, BFB0)
                    Store (ECRW (0x24), Local0)
                    Release (ECM1)
                    Return (Local0)
                }

                If (LEqual (Arg1, 0x05))
                {
                    Acquire (ECM1, 0xFFFF)
                    ECWB (0x03, BFB0)
                    Store (ECRW (0x26), Local3)
                    Release (ECM1)
                    Return (Local3)
                }

                If (LEqual (Arg1, 0x06))
                {
                    Acquire (ECM1, 0xFFFF)
                    ECWB (0x03, BFB0)
                    Store (ECRB (0x29), Local3)
                    Store (ECU0 (BS03, Local3), Local3)
                    Release (ECM1)
                    Return (ToString (Local3, Ones))
                }

                If (LEqual (Arg1, 0x07))
                {
                    Acquire (ECM1, 0xFFFF)
                    ECWB (0x03, BFB0)
                    Store (ECRW (0x18), Local3)
                    Release (ECM1)
                    Return (Local3)
                }

                If (LEqual (Arg1, 0x08))
                {
                    Acquire (ECM1, 0xFFFF)
                    ECWB (0x03, BFB0)
                    Store (ECRW (0x12), Local3)
                    Release (ECM1)
                    Return (Local3)
                }

                If (LEqual (Arg1, 0x09))
                {
                    Acquire (ECM1, 0xFFFF)
                    ECWB (0x03, BFB0)
                    Store (ECRW (0x14), Local3)
                    Release (ECM1)
