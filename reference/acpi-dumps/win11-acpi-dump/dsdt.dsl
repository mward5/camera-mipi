                }
                Else
                {
                    Store (Arg0, HIDX) /* \_SB_.HIDD.HIDX */
                }

                Notify (HIDD, 0xC0) // Hardware-Specific
                Store (Zero, Local0)
                While (LAnd (LLess (Local0, 0xFA), HBSY))
                {
                    Sleep (0x04)
                    Increment (Local0)
