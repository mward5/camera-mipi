                        {
                            Return (Buffer (One)
                            {
                                 0x09                                             // .
                            })
                        }

                        If (LEqual (Arg2, One)){}
                        If (LEqual (Arg2, 0x02)){}
                        If (LEqual (Arg2, 0x03))
                        {
                            If (LEqual (WRTO, One)){}
                            ElseIf (LEqual (WRTO, 0x03)){}
                            Else
                            {
                            }

                            Return (WRTO) /* \WRTO */
                        }
                    }
                }

                Return (Buffer (One)
                {
                     0x00                                             // .
                })
            }
        }
    }

