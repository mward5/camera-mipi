                    Return (0x0F)
                }

                Return (Zero)
            }

            Method (_CRS, 0, NotSerialized)  // _CRS: Current Resource Settings
            {
                If (LLess (OSYS, 0x07DC))
                {
                    Return (SBFI) /* \_SB_.PC00.I2C4.TPL0.SBFI */
                }

                If (LEqual (TPLM, Zero))
                {
                    Return (ConcatenateResTemplate (I2CM (I2CX, BADR, SPED), SBFG))
                }

                Return (ConcatenateResTemplate (I2CM (I2CX, BADR, SPED), SBFI))
            }
        }
    }

    If (LNotEqual (WRTO, Zero))
    {
        Scope (_SB.PC00.RP10)
        {
            Name (BRST, Package (0x02)
            {
                Zero, 
                Zero
            })
            Store (WBRS, Index (BRST, Zero))
            Store (PBRS, Index (BRST, One))
            Name (RSTG, Package (0x02)
            {
                Zero, 
                Zero
            })
            Store (PRST, Index (RSTG, Zero))
            Store (WPRP, Index (RSTG, One))
            Name (PWRG, Package (0x02)
            {
                Zero, 
                Zero
            })
            Store (WFCP, Index (PWRG, Zero))
            Store (PFCP, Index (PWRG, One))
            Name (WAKG, Zero)
            Store (WWKP, WAKG) /* \_SB_.PC00.RP10.WAKG */
            Name (SCLK, 0x05)
            Name (WKEN, Zero)
            Name (WOFF, Zero)
            Name (OFEN, One)
            Name (ONEN, Zero)
            Method (_S0W, 0, Serialized)  // _S0W: S0 Device Wake State
            {
                If (LEqual (WRTO, 0x03))
