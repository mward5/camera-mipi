                {
                    SRXO (GPLI, One)
                }

                Store (GNUM (GPLI), INT1) /* \_SB_.PC00.I2C4.TPL0.INT1 */
                Store (INUM (GPLI), INT2) /* \_SB_.PC00.I2C4.TPL0.INT2 */
                If (LEqual (TPLM, Zero))
                {
