                Store (ST40, Index (DerefOf (Index (EWRY, One)), 0x2F))
                Store (ST41, Index (DerefOf (Index (EWRY, One)), 0x30))
                Store (ST42, Index (DerefOf (Index (EWRY, One)), 0x31))
