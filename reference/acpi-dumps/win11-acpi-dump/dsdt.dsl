                PowerResource (PXP, 0x00, 0x0000)
                {
                    Method (_STA, 0, Serialized)  // _STA: Status
                    {
                        If (LEqual (VDID, 0xFFFFFFFF))
                        {
                            Return (Zero)
                        }

