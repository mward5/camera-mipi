        Method (PSD3, 1, Serialized)
        {
            Store (Zero, Local0)
            If (LOr (LEqual (SIME, One), LNot (IMPS ())))
            {
                Return (Zero)
            }

            Switch (Add (Zero, Decrement (Arg0)))
            {
                Case (Zero)
                {
                    Store (One, RAA0) /* \RAA0 */
                    While (LAnd (LEqual (APA0, Zero), LLess (Local0, 0x2710)))
                    {
                        Increment (Local0)
                        Sleep (One)
                    }
                }
                Case (One)
