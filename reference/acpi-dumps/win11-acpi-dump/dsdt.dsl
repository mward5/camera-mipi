                {
                    Return (WFRC) /* \WFRC */
                }

                If (LEqual (Arg2, 0x05))
                {
                    Return (WFUC) /* \WFUC */
                }

                If (LEqual (Arg2, 0x07))
                {
                    Return (UNI4) /* \UNI4 */
                }

