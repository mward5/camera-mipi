                    Return (0x04)
                }
                Else
                {
                    Return (Zero)
                }
            }

            Method (_DSW, 3, NotSerialized)  // _DSW: Device Sleep Wake
            {
                If (Arg1)
                {
                    Store (Zero, WKEN) /* \_SB_.PC00.RP10.WKEN */
                }
                ElseIf (LAnd (Arg0, Arg2))
                {
                    Store (One, WKEN) /* \_SB_.PC00.RP10.WKEN */
                }
                Else
                {
                }
            }

            If (LEqual (WWEN, 0x02))
            {
                PowerResource (PXP5, 0x00, 0x0000)
                {
                    Method (_STA, 0, Serialized)  // _STA: Status
                    {
                        If (LEqual (VDID, 0xFFFFFFFF))
                        {
                            Return (Zero)
                        }

                        Return (PSTA ())
                    }

                    Method (_ON, 0, Serialized)  // _ON_: Power On
                    {
                        Store (Acquire (WWMT, 0x03E8), Local0)
                        If (LEqual (Local0, Zero))
                        {
                            If (LEqual (VDID, 0xFFFFFFFF))
                            {
                                Release (WWMT)
                                Return (Zero)
                            }

                            If (LEqual (OFEN, One))
                            {
                                Release (WWMT)
                                Return (Zero)
                            }

                            SHPO (WAKG, One)
                            PON5 ()
                            L23D ()
                            If (CondRefOf (WOFF))
                            {
                                If (LNotEqual (WOFF, Zero))
                                {
                                    Store (Zero, WOFF) /* \_SB_.PC00.RP10.WOFF */
                                    Sleep (TR2P)
                                }
                            }

                            Store (One, OFEN) /* \_SB_.PC00.RP10.OFEN */
                            Release (WWMT)
                        }
                    }

                    Method (_OFF, 0, Serialized)  // _OFF: Power Off
                    {
                        Store (Acquire (WWMT, 0x03E8), Local0)
                        If (LEqual (Local0, Zero))
                        {
                            If (LEqual (VDID, 0xFFFFFFFF))
                            {
                                Release (WWMT)
                                Return (Zero)
                            }

