                    {
                        Store (DCTR, Local0)
                        Or (Local0, 0x8000, Local0)
                        Store (Local0, DCTR) /* \_SB_.PC00.RP14.PXSX.DCTR */
                    }
                }
            }

            Method (_PRR, 0, NotSerialized)  // _PRR: Power Resource for Reset
            {
                If (WIST ())
                {
                    If (CondRefOf (WRST))
                    {
                        Return (Package (0x01)
                        {
                            WRST, 
                        })
                    }
                }

                If (LAnd (LNotEqual (WWEN, Zero), LEqual (WWRP, SLOT)))
                {
                    If (CondRefOf (MRST))
                    {
                        Return (Package (0x01)
                        {
                            MRST, 
                        })
                    }
                }

                Return (Package (0x01)
                {
                    DRST, 
                })
            }

            Method (IFUN, 4, Serialized)
            {
                If (LEqual (Arg2, Zero))
                {
                    If (LEqual (Arg1, Zero))
                    {
                        Return (Buffer (One)
                        {
                             0x0F                                             // .
                        })
                    }
                    Else
                    {
                        Return (Buffer (One)
                        {
                             0x00                                             // .
                        })
                    }
                }

                If (LEqual (Arg2, One))
                {
                    ShiftLeft (CVPR, Zero, Local0)
                    Return (Local0)
                }

                If (LEqual (Arg2, 0x02))
                {
                    CreateWordField (Arg3, Zero, CMDT)
                    CreateWordField (Arg3, 0x02, CMDP)
                    If (LEqual (CMDT, One))
                    {
                        If (CondRefOf (\_SB.PC00.CNVW.RSTT))
                        {
                            Return (^^^CNVW.RSTT) /* \_SB_.PC00.CNVW.RSTT */
                        }
                        Else
                        {
                            Return (Zero)
                        }
                    }

                    If (LEqual (CMDT, 0x02))
                    {
                        If (CondRefOf (\_SB.PC00.CNVW.RSTT))
                        {
                            Store (CMDP, ^^^CNVW.RSTT) /* \_SB_.PC00.CNVW.RSTT */
                        }

                        Return (Zero)
                    }

                    If (LEqual (CMDT, 0x03))
                    {
                        If (CondRefOf (\_SB.PC00.CNVW.PRRS))
                        {
                            Return (^^^CNVW.PRRS) /* \_SB_.PC00.CNVW.PRRS */
                        }
                        Else
                        {
                            Return (Zero)
                        }
                    }

                    Return (Zero)
                }

                If (LEqual (Arg2, 0x03))
                {
                    If (LEqual (CRFI, One))
                    {
                        Return (Zero)
                    }
                    Else
                    {
                        Return (One)
                    }
                }

                Return (Zero)
            }

            Method (IDSM, 1, Serialized)
            {
                If (LEqual (Arg0, ToUUID ("7266172c-220b-4b29-814f-75e4dd26b5fd") /* Unknown UUID */))
                {
                    Return (One)
                }

                Return (Zero)
            }

            Method (EFUN, 4, Serialized)
            {
                If (LEqual (Arg2, Zero))
                {
                    If (LEqual (Arg1, Zero))
                    {
                        Return (Buffer (One)
                        {
                             0x7F                                             // .
                        })
                    }
                    Else
                    {
                        Return (Buffer (One)
                        {
                             0x00                                             // .
                        })
                    }
                }

                If (LEqual (Arg2, One))
                {
                    Store (ACSD, Local0)
                    Return (Local0)
                }

                If (LEqual (Arg2, 0x02))
                {
                    Store (I5BS, Local0)
                    Return (Local0)
                }

                If (LEqual (Arg2, 0x03))
                {
                    Store (UHBS, Local0)
                    Return (Local0)
                }

                If (LEqual (Arg2, 0x06))
                {
                    Store (AXMU, Local0)
                    ShiftLeft (Local0, One, Local0)
                    Or (Local0, AXSU, Local0)
                    Store (AXMR, Local1)
                    ShiftLeft (Local1, One, Local1)
                    Or (Local1, AXSR, Local1)
                    ShiftLeft (Local1, 0x02, Local1)
                    Or (Local0, Local1, Local0)
                    Return (Local0)
                }

                If (LEqual (Arg2, 0x04))
                {
                    Return (WFRC) /* \WFRC */
                }

                If (LEqual (Arg2, 0x05))
                {
                    Return (WFUC) /* \WFUC */
                }

                If (LEqual (Arg2, 0x07))
                {
                    Return (UNI4) /* \UNI4 */
                }

                If (LEqual (Arg2, 0x08))
                {
                    Return (WFIC) /* \WFIC */
                }

                Return (Zero)
            }

            Method (EDSM, 1, Serialized)
            {
                If (LEqual (Arg0, ToUUID ("f21202bf-8f78-4dc6-a5b3-1f738e285ade") /* Unknown UUID */))
                {
                    Return (One)
                }

                Return (Zero)
            }

            Method (_DSM, 4, Serialized)  // _DSM: Device-Specific Method
            {
                If (WIST ())
                {
                    If (EDSM (Arg0))
                    {
                        Return (EFUN (Arg0, Arg1, Arg2, Arg3))
                    }

                    If (IDSM (Arg0))
                    {
                        Return (IFUN (Arg0, Arg1, Arg2, Arg3))
                    }
                }

                If (LAnd (LNotEqual (WWEN, Zero), LEqual (WWRP, SLOT)))
                {
                    If (LEqual (Arg0, ToUUID ("bad01b75-22a8-4f48-8792-bdde9467747d") /* Unknown UUID */))
                    {
                        If (LEqual (Arg2, Zero))
                        {
                            Return (Buffer (One)
                            {
                                 0x09                                             // .
                            })
                        }

                        If (LEqual (Arg2, One)){}
                        If (LEqual (Arg2, 0x02)){}
                        If (LEqual (Arg2, 0x03))
                        {
                            If (LEqual (WRTO, One)){}
                            ElseIf (LEqual (WRTO, 0x03)){}
                            Else
                            {
                            }

                            Return (WRTO) /* \WRTO */
                        }
                    }
                }

                Return (Buffer (One)
                {
                     0x00                                             // .
                })
            }
        }
    }

