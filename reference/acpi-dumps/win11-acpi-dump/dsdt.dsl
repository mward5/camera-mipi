                PSD0 (SLOT)
                SPCO (WCLK, One)
                SGOV (WFCP, PFCP)
                Sleep (TN2B)
                SGOV (WBRS, And (Not (PBRS), One))
                Sleep (TB2R)
                SGOV (PRST, And (Not (WPRP), One))
