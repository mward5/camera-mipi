                        Default
                        {
                            Store (0x8000, Index (RTVL, Zero))
                        }

                    }
                }
                Default
                {
                    Store (0x8000, Index (RTVL, Zero))
                }

            }

            Return (RTVL) /* \_SB_.PC00.LPCB.ECDV.CMFC.RTVL */
        }
