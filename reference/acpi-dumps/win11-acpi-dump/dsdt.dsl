        Method (CSD3, 1, Serialized)
        {
            Store (Zero, Local0)
            If (LOr (LEqual (SIME, One), LNot (IMPS ())))
            {
                Return (Zero)
            }

            Switch (ToInteger (Arg0))
            {
                Case (0x14)
                {
                    Store (One, RSAT) /* \RSAT */
                    While (LAnd (LEqual (ASAT, Zero), LLess (Local0, 0x2710)))
