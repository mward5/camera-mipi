                        /* 0010 */  0xFF, 0xFF, 0xFF, 0xFF                           // ....
                    }
                })
                CreateByteField (DerefOf (Index (PLDB, Zero)), 0x08, BPOS)
                CreateField (DerefOf (Index (PLDB, Zero)), 0x73, 0x04, RPOS)
