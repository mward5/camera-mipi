                Store (BIWP, BBD0) /* \_SB_.AMW5.BBD0 */
                If (LEqual (BBD0, Zero))
                {
                    Return (Zero)
                }

                Store (DM08 (BBD0, 0x18), Local2)
                CreateQWordField (Local2, Zero, BITI)
                CreateDWordField (Local2, 0x08, BINI)
                CreateQWordField (Local2, 0x0C, BITA)
                CreateDWordField (Local2, 0x14, BINA)
                Return (Zero)
            }

            Method (BBM2, 3, Serialized)
            {
                Name (BBD3, Package (0x03){})
                If (LGreater (Arg0, Arg2))
                {
                    Store (0x02, Index (BBD3, 0x02))
                    Store (One, Index (BBD3, One))
                    Store (Buffer (One)
                        {
                             0x00                                             // .
                        }, Index (BBD3, 0x02))
                    Return (BBD3) /* \_SB_.AMW5.BBM2.BBD3 */
                }

                Multiply (Arg0, 0x18, Local0)
                Add (Arg1, Local0, Local0)
                Store (DM08 (Local0, 0x08), Local1)
                CreateQWordField (Local1, Zero, BIAE)
                Store (DM08 (BIAE, 0x06), Local2)
                CreateWordField (Local2, 0x04, BIAL)
                Add (BIAE, 0x06, Local3)
                Store (DM08 (Local3, BIAL), Local4)
                Store (Zero, Index (BBD3, Zero))
                Store (BIAL, Index (BBD3, One))
                Store (Local4, Index (BBD3, 0x02))
                Return (BBD3) /* \_SB_.AMW5.BBM2.BBD3 */
            }

            Method (BBM3, 1, Serialized)
            {
                Name (BBD4, Package (0x03){})
                If (LEqual (BBD0, Zero))
                {
                    Store (One, Index (BBD4, Zero))
                    Store (One, Index (BBD4, One))
                    Store (Zero, Index (BBD4, 0x02))
                    Return (BBD4) /* \_SB_.AMW5.BBM3.BBD4 */
                }

                Store (DM08 (BBD0, 0x18), Local0)
                If (LEqual (Arg0, Zero))
                {
                    Store (0x08, Local1)
                }
                Else
                {
                    Store (0x14, Local1)
                }

                CreateDWordField (Local0, Local1, BIIC)
                Store (Zero, Index (BBD4, Zero))
                Store (One, Index (BBD4, One))
                Store (BIIC, Index (BBD4, 0x02))
                Return (BBD4) /* \_SB_.AMW5.BBM3.BBD4 */
            }

            Method (BBM4, 2, Serialized)
            {
                Name (BBD5, Package (0x03){})
                If (LEqual (BBD0, Zero))
                {
                    Store (One, Index (BBD5, Zero))
                    Store (Zero, Index (BBD5, One))
                    Store (Buffer (One)
                        {
                             0x00                                             // .
                        }, Index (BBD5, 0x02))
                    Return (BBD5) /* \_SB_.AMW5.BBM4.BBD5 */
                }

                Store (DM08 (BBD0, 0x18), Local0)
                If (LEqual (Arg0, Zero))
                {
                    Store (Zero, Local1)
                    Store (0x08, Local2)
                }
                Else
                {
                    Store (0x0C, Local1)
                    Store (0x14, Local2)
                }

                CreateQWordField (Local0, Local1, BIIT)
                CreateDWordField (Local0, Local2, BICN)
                CreateDWordField (Arg1, Zero, RIDX)
                Return (BBM2 (RIDX, BIIT, BICN))
            }

            Method (BBM6, 2, Serialized)
            {
                Name (BBD8, Buffer (0x0A){})
                CreateByteField (BBD8, Zero, ICMD)
                CreateByteField (BBD8, One, IDAT)
                Store (Arg0, ICMD) /* \_SB_.AMW5.BBM6.ICMD */
                Store (Arg1, IDAT) /* \_SB_.AMW5.BBM6.IDAT */
                Return (GENS (One, BBD8, SizeOf (BBD8)))
            }

            Method (BBM7, 3, Serialized)
            {
                Name (BCD0, Buffer (0x0100){})
                CreateDWordField (BCD0, 0x04, ISIZ)
                CreateByteField (BCD0, 0x08, ICMD)
                Store (Arg1, ISIZ) /* \_SB_.AMW5.BBM7.ISIZ */
                Store (Arg0, ICMD) /* \_SB_.AMW5.BBM7.ICMD */
                Store (ISIZ, Local1)
                Multiply (Local1, 0x08, Local1)
                CreateField (BCD0, 0x60, Local1, IDAT)
                Store (Arg2, IDAT) /* \_SB_.AMW5.BBM7.IDAT */
                If (LEqual (ICMD, 0x03)){}
                If (LEqual (ICMD, 0x04)){}
                Return (GENS (0x02, BCD0, SizeOf (BCD0)))
            }

            Name (BBD1, Zero)
            Name (BBD2, Zero)
            Method (BBM5, 1, Serialized)
            {
                Name (BBD6, Buffer (0x04){})
                CreateDWordField (BBD6, Zero, STAT)
                If (LEqual (Arg0, Zero))
                {
                    Store (BBD1, Local0)
                    Store (Zero, Local1)
                    Store (0x08, Local2)
                }
                Else
                {
                    Store (BBD2, Local0)
                    Store (One, Local1)
                    Store (0x14, Local2)
                }

                If (LEqual (Local0, Zero))
                {
                    If (LEqual (BBD0, Zero))
                    {
                        Store (One, STAT) /* \_SB_.AMW5.BBM5.STAT */
                        Return (STAT) /* \_SB_.AMW5.BBM5.STAT */
                    }

                    Store (DM08 (BBD0, 0x18), Local3)
                    CreateDWordField (Local3, Local2, BIC2)
                    Store (Zero, STAT) /* \_SB_.AMW5.BBM5.STAT */
                    If (LGreater (BIC2, Zero))
                    {
                        Store (BBM6 (Zero, Local1), Local4)
                        Store (One, Local0)
                        CreateQWordField (Local4, 0x02, RSTA)
                        If (LNotEqual (RSTA, Zero))
                        {
                            Store (One, STAT) /* \_SB_.AMW5.BBM5.STAT */
                        }
                        Else
                        {
                            Store (Zero, STAT) /* \_SB_.AMW5.BBM5.STAT */
                        }
                    }
                }

                Return (STAT) /* \_SB_.AMW5.BBM5.STAT */
            }

            Method (WMBB, 3, Serialized)
            {
                If (LEqual (Arg1, One))
                {
                    Return (BBM3 (Zero))
                }

                If (LEqual (Arg1, 0x02))
                {
                    Return (BBM3 (One))
                }

                If (LEqual (Arg1, 0x03))
                {
                    Return (BBM4 (Zero, Arg2))
                }

                If (LEqual (Arg1, 0x04))
                {
                    Return (BBM4 (One, Arg2))
                }

                If (LEqual (Arg1, 0x05))
                {
                    Return (BBM5 (Zero))
                }

                If (LEqual (Arg1, 0x06))
                {
                    Return (BBM5 (One))
                }

                If (LEqual (Arg1, 0x07))
                {
                    CreateByteField (Arg2, Zero, SLCP)
                    If (LGreater (SLCP, 0x03))
                    {
                        Return (0x02)
                    }

                    Store (BBM6 (One, SLCP), Local0)
                    CreateQWordField (Local0, 0x02, RSTA)
                    If (LNotEqual (RSTA, Zero))
                    {
                        Return (One)
                    }
                    Else
                    {
                        Return (Zero)
                    }
                }

                If (LEqual (Arg1, 0x08))
                {
                    Name (BBD7, Package (0x02){})
                    Store (BBM6 (0x02, 0x03), Local0)
                    CreateQWordField (Local0, 0x02, RSTB)
                    If (LNotEqual (RSTB, Zero))
                    {
                        Store (One, Index (BBD7, Zero))
                    }
                    Else
                    {
                        Store (Zero, Index (BBD7, Zero))
                    }

                    CreateByteField (Local0, One, GLCP)
                    Store (GLCP, Index (BBD7, One))
                    Return (BBD7) /* \_SB_.AMW5.WMBB.BBD7 */
                }

                If (LEqual (Arg1, 0x09))
                {
                    CreateDWordField (Arg2, Zero, BSIZ)
                    Store (BSIZ, Local1)
                    Multiply (Local1, 0x08, Local1)
                    CreateField (Arg2, 0x20, Local1, BDAT)
                    Store (BBM7 (0x04, BSIZ, BDAT), Local0)
                    CreateDWordField (Local0, Zero, RSTD)
                    If (LNotEqual (RSTD, Zero))
                    {
                        Return (One)
                    }
                    Else
                    {
                        Return (Zero)
                    }
                }

                If (LEqual (Arg1, 0x0A))
                {
                    Name (BBD9, Package (0x03){})
                    Store (BBM7 (0x03, 0xF4, Zero), Local0)
                    CreateDWordField (Local0, Zero, RSTC)
                    If (LNotEqual (RSTC, Zero))
                    {
                        Store (One, Index (BBD9, Zero))
                    }
                    Else
                    {
                        Store (Zero, Index (BBD9, Zero))
                    }

                    CreateDWordField (Local0, 0x04, QSIZ)
                    Store (QSIZ, Local1)
                    Multiply (Local1, 0x08, Local1)
                    CreateField (Local0, 0x60, Local1, QDAT)
                    Store (QSIZ, Index (BBD9, One))
                    Store (QDAT, Index (BBD9, 0x02))
                    Return (BBD9) /* \_SB_.AMW5.WMBB.BBD9 */
                }

                If (LEqual (Arg1, 0x0B))
                {
                    CreateByteField (Arg2, Zero, SBDR)
                    Store (BBM6 (0x05, SBDR), Local0)
                    CreateQWordField (Local0, 0x02, RSTE)
                    If (LNotEqual (RSTE, Zero))
                    {
                        Return (One)
                    }
                    Else
                    {
                        Return (Zero)
                    }
                }
            }

