                {
                    /* 0000 */  0x89, 0x06, 0x00, 0x15, 0x01, 0x00, 0x00, 0x00,  // ........
                    /* 0008 */  0x00, 0x79, 0x00                                 // .y.
                })
                Name (GBUF, Buffer (0x25)
                {
                    /* 0000 */  0x8C, 0x20, 0x00, 0x01, 0x00, 0x01, 0x00, 0x12,  // . ......
                    /* 0008 */  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x17, 0x00,  // ........
                    /* 0010 */  0x00, 0x19, 0x00, 0x23, 0x00, 0x00, 0x00, 0x00,  // ...#....
                    /* 0018 */  0x00, 0x5C, 0x5F, 0x53, 0x42, 0x2E, 0x47, 0x50,  // .\_SB.GP
                    /* 0020 */  0x49, 0x30, 0x00, 0x79, 0x00                     // I0.y.
                })
                Name (UBUF, Buffer (0x25)
                {
                    /* 0000 */  0x8C, 0x20, 0x00, 0x01, 0x01, 0x01, 0x00, 0x01,  // . ......
                    /* 0008 */  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x17, 0x00,  // ........
                    /* 0010 */  0x00, 0x19, 0x00, 0x23, 0x00, 0x00, 0x00, 0x00,  // ...#....
                    /* 0018 */  0x00, 0x5C, 0x5F, 0x53, 0x42, 0x2E, 0x47, 0x50,  // .\_SB.GP
                    /* 0020 */  0x49, 0x30, 0x00, 0x79, 0x00                     // I0.y.
                })
                CreateWordField (BBUF, 0x17, SPIN)
                CreateWordField (GBUF, 0x17, GPIN)
                CreateDWordField (IBUF, 0x05, IPIN)
                CreateWordField (UBUF, 0x17, UPIN)
                CreateBitField (IBUF, 0x1A, ILVL)
                CreateBitField (IBUF, 0x19, ITRG)
                CreateField (GBUF, 0x39, 0x02, GLVL)
                CreateBitField (GBUF, 0x38, GTRG)
                Store (GNUM (GFPS), SPIN) /* \_SB_.PC00.SPI1.FPNT._CRS.SPIN */
                Store (GNUM (GFPI), GPIN) /* \_SB_.PC00.SPI1.FPNT._CRS.GPIN */
                Store (INUM (GFPI), IPIN) /* \_SB_.PC00.SPI1.FPNT._CRS.IPIN */
                Store (GNUM (GFPI), UPIN) /* \_SB_.PC00.SPI1.FPNT._CRS.UPIN */
                If (LOr (LEqual (FPTT, 0x02), LEqual (FPTT, 0x06)))
                {
                    Store (Zero, ILVL) /* \_SB_.PC00.SPI1.FPNT._CRS.ILVL */
                    Store (One, ITRG) /* \_SB_.PC00.SPI1.FPNT._CRS.ITRG */
                    Store (Zero, GLVL) /* \_SB_.PC00.SPI1.FPNT._CRS.GLVL */
                    Store (One, GTRG) /* \_SB_.PC00.SPI1.FPNT._CRS.GTRG */
                }

                If (LEqual (FPTT, 0x04))
                {
                    Store (Zero, ILVL) /* \_SB_.PC00.SPI1.FPNT._CRS.ILVL */
                    Store (One, ITRG) /* \_SB_.PC00.SPI1.FPNT._CRS.ITRG */
                }

                Switch (ToInteger (FPTT))
                {
                    Case (One)
                    {
                        Store (0x00989680, Local1)
                        Store (Zero, Local0)
                    }
                    Case (0x02)
                    {
                        Store (0x002DC6C0, Local1)
                        Store (Zero, Local0)
                    }
                    Case (0x03)
                    {
                        Store (0x007A1200, Local1)
                        Store (One, Local0)
                    }
                    Case (0x04)
                    {
                        Store (0x007A1200, Local1)
                        Store (Zero, Local0)
                    }
                    Case (0x05)
                    {
                        Store (0x00F42400, Local1)
                        Store (Zero, Local0)
                    }
                    Case (0x06)
                    {
                        Store (0x002DC6C0, Local1)
                        Store (Zero, Local0)
                    }
                    Default
                    {
                        Store (Zero, Local1)
                        Store (Zero, Local0)
                    }

